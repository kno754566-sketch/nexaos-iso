#!/bin/bash
set -e
# ブランド名をNexaOSにする
cat > /etc/os-release <<'OSREL'
PRETTY_NAME="NexaOS 1.0"
NAME="NexaOS"
VERSION="1.0"
ID=nexaos
ID_LIKE=debian
EOF_PLACEHOLDER=
OSREL
sed -i '/EOF_PLACEHOLDER/d' /etc/os-release
echo "NexaOS 1.0 \n \l" > /etc/issue
# Google Chrome（Google公式のdebを取得してインストール）
wget -qO /tmp/chrome.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
apt-get install -y /tmp/chrome.deb
rm -f /tmp/chrome.deb
