#!/bin/bash
set -e
# ブランド名をNexaOSにする
cat > /etc/os-release <<'OSREL'
PRETTY_NAME="NexaOS 1.0"
NAME="NexaOS"
VERSION="1.0"
ID=nexaos
ID_LIKE=debian
EOF_PLACEHOLDER=
OSREL
sed -i '/EOF_PLACEHOLDER/d' /etc/os-release
echo "NexaOS 1.0 \n \l" > /etc/issue

# Windows風アイコン（取得に失敗してもビルドは止めない）
(
  set +e
  git clone --depth 1 https://github.com/vinceliuice/Fluent-icon-theme /tmp/fi && (cd /tmp/fi && ./install.sh)
  if [ -d /usr/share/icons/Fluent ]; then printf '\n[Icons]\nTheme=Fluent\n' >> /etc/skel/.config/kdeglobals; fi
  rm -rf /tmp/fi
) || true

# NexaWebだけをメニューに出す（素のChromiumは隠す。失敗しても止めない）
sed -i '0,/^\[Desktop Entry\]/s//[Desktop Entry]\nNoDisplay=true/' /usr/share/applications/chromium.desktop || true
gtk-update-icon-cache -f /usr/share/icons/hicolor || true

# ファイアウォールと毎日のバックアップを最初から有効にする（失敗しても止めない）
sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf || true
systemctl enable ufw.service nexa-backup.timer || true

# ストアの入口を「Nexaストア」に一本化・独自サービスを有効化・ガーネース仕様の表示
sed -i '0,/^\[Desktop Entry\]/s//[Desktop Entry]\nNoDisplay=true/' /usr/share/applications/org.kde.discover.desktop || true
systemctl enable nexasearch.service zramswap.service unattended-upgrades.service || true
printf 'NexaOS 1.0 (ガーネース) \\n \\l\n' > /etc/issue
printf 'NexaOS 1.0\n' > /etc/issue.net
printf 'DISTRIB_ID=NexaOS\nDISTRIB_RELEASE=1.0\nDISTRIB_DESCRIPTION="NexaOS 1.0"\n' > /etc/lsb-release
[ -f /etc/default/grub ] && sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="NexaOS"/' /etc/default/grub || true
for f in /etc/calamares/branding/*/branding.desc; do
  [ -f "$f" ] && sed -i -E 's/^(\s*(productName|shortProductName|bootloaderEntryName):\s*).*/\1NexaOS/; s/^(\s*(versionedName|shortVersionedName):\s*).*/\1NexaOS 1.0/' "$f" || true
done

# インストールしたOSは、必ずログイン画面でパスワードを入れる
sed -i 's/^doAutologin:.*/doAutologin: false/' /etc/calamares/modules/users.conf || true

# 見た目をNexaOS風にする（KDE・Debianの名前を隠す。失敗しても止めない）
set +e
echo 'LOGO=nexaos-logo' >> /etc/os-release
mkdir -p /usr/local/share/applications
rename() {
  f=/usr/share/applications/$1; [ -f "$f" ] || return 0
  awk -v n="$2" '/^\[/{s=($0=="[Desktop Entry]"); print; if(s){print "Name=" n; print "Name[ja]=" n}; next} s&&/^(Name|GenericName)(\[[^]]*\])?=/{next} {print}' "$f" > "/usr/local/share/applications/$1"
}
rename org.kde.dolphin.desktop "Nexaファイル"
rename org.kde.konsole.desktop "Nexaターミナル"
rename org.kde.kate.desktop "Nexaメモ"
rename systemsettings.desktop "Nexa設定"
rename org.kde.plasma-systemmonitor.desktop "Nexaモニター"
echo '. /usr/share/nexaos/prompt.sh' >> /etc/skel/.bashrc
# 起動画面（文字ではなくロゴを表示）
plymouth-set-default-theme -R nexaos
# インストール後のブートメニューはほぼ隠し、UEFIの項目名もNexaOSにする
if [ -f /etc/default/grub ]; then
  sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=2/' /etc/default/grub
  grep -q '^GRUB_TIMEOUT_STYLE' /etc/default/grub && sed -i 's/^GRUB_TIMEOUT_STYLE=.*/GRUB_TIMEOUT_STYLE=hidden/' /etc/default/grub || echo 'GRUB_TIMEOUT_STYLE=hidden' >> /etc/default/grub
fi
sed -i 's/^efiBootloaderId:.*/efiBootloaderId: "nexaos"/' /etc/calamares/modules/bootloader.conf
true

# 「このシステムについて」の項目を隠し、NexaCenterの案内に一本化する（見つからなくても止めない）
set +e
for f in $(grep -rl -i 'about-distro\|X-KDE-System-Settings-Parent-Category=about-distro' /usr/share/applications /usr/share/kservices5 /usr/share/kservices6 2>/dev/null); do
  grep -q '^NoDisplay=true' "$f" || sed -i '0,/^\[Desktop Entry\]/s//[Desktop Entry]\nNoDisplay=true/' "$f"
done
true

# 初回起動時のキャラクター付きウィザード（plasma-welcome）を無効化する（無ければ何もしない）
set +e
apt-get purge -y plasma-welcome 2>/dev/null
for f in /etc/xdg/autostart/org.kde.plasma-welcome.desktop /usr/share/applications/org.kde.plasma-welcome.desktop; do
  [ -f "$f" ] && sed -i '0,/^\[Desktop Entry\]/s//[Desktop Entry]\nNoDisplay=true\nX-KDE-autostart-condition=false/' "$f"
done
true

# 毎回の起動時に、管理者権限を取りにくくする（ライブ環境の自動sudoを上書きする）
systemctl enable nexa-harden.service || true
passwd -l root || true
sed -i 's/^#\s*auth\s\+required\s\+pam_wheel.so\s\+group=sudo.*/auth       required   pam_wheel.so group=sudo/' /etc/pam.d/su || true

# さらにLinuxだと分かりにくくする（システムの動きには影響しない範囲で）
set +e
# ターミナルで直接 uname と打ったときの表示だけをNexaOS風にする（スクリプトやプログラムには影響しない）
cat >> /etc/skel/.bashrc <<'INNER'
uname() { if [ "$#" -eq 0 ]; then command echo "NexaOS"; else command uname "$@" | sed 's/Linux/NexaOS/'; fi; }
INNER

# GRUBの起動メニューの表示から「GNU/Linux」の文字を消す（起動そのものには影響しない）
[ -f /etc/grub.d/10_linux ] && sed -i 's/GNU\/Linux//g' /etc/grub.d/10_linux

# 見えにくい場所にあるディストリビューション名の手がかりを消す
rm -f /etc/debian_version
true

# 新しいアプリの表示名をNexa風にし、リモート操作は既定でオフにする
rename org.kde.kdeconnect.app.desktop "NexaShare"
rename simplescreenrecorder.desktop "Nexa録画"
systemctl disable xrdp 2>/dev/null
true
